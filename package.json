{
  "name": "rooc-guild-suite",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate:deploy": "prisma migrate deploy",
    "call-to-arms:reminder": "tsx scripts/call-to-arms-reminder.ts",
    "test:combat-engine": "tsx --test tests/ro3-combat-engine.test.mjs tests/ro3-combat-game-data.test.mjs tests/ro3-combat-input-validation.test.mjs tests/ro3-combat-skill-options.test.mjs tests/ro3-combat-equipment-options.test.mjs tests/ro3-combat-build-input.test.mjs tests/ro3-talent-digest-import.test.mjs tests/ro3-native-build-storage.test.mjs",
    "test:billing": "tsx --test src/lib/billing/entitlement-status-core.test.ts",
    "test:ro3-scoring": "tsx --test src/lib/ro3-combat-simulator/scoring.test.ts src/lib/ro3-combat-simulator/scoring.synthetic.test.ts src/lib/ro3-combat-simulator/raw-stat-support.test.ts src/lib/ro3-combat-simulator/persisted-stat-adapter.test.ts src/lib/ro3-combat-simulator/sensitivity-harness.test.ts src/lib/ro3-combat-simulator/simulator-dps-evaluator.test.ts src/lib/ro3-combat-simulator/simulator-rotation-evaluator.test.ts",
    "export:ro3-calibration": "tsx scripts/export-ro3-scoring-calibration-cohort.ts",
    "report:ro3-sensitivity": "tsx scripts/report-ro3-sensitivity.ts",
    "test:security": "tsx --test tests/security-upload-validation.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bmp-js": "^0.1.0",
    "dotenv": "^17.4.2",
    "next": "16.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "stripe": "^18.5.0",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.0.0",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.3"
  },
  "overrides": {
    "effect": "^3.22.1"
  }
}
