generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// ENUMS
// =============================================================

enum MemberPriority {
  LEADER
  OFFICER
  COUNCIL
  MEMBER
}

enum UserRole {
  ADMIN
  MANAGER
  OFFICER
  MEMBER
}

enum ResourceType {
  FEATHER
  CARD
}

enum AllocationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BidPageType {
  FEATHER
  CARD
}

enum EventType {
  GUILD_LEAGUE
  EMPERIUM_OVERRUN
}

enum Battlefield {
  BATTLEFIELD_1
  BATTLEFIELD_2
}

enum RosterGenerationMode {
  MANUAL
  AUTOMATIC
}

// =============================================================
// USER
// =============================================================
//
// A User represents a global SaaS account.
//
// The same Discord account can belong to multiple guilds.
// Guild-specific permissions are stored on GuildMembership,
// NOT on User.
//
// =============================================================

model User {
  id        String  @id @default(cuid())
  discordId String  @unique
  username  String
  avatarUrl String?

  // -----------------------------------------------------------
  // Relations
  // -----------------------------------------------------------

  guildMemberships GuildMembership[]

  guildMembers GuildMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================
// GUILD
// =============================================================
//
// A Guild represents a customer/community using the SaaS.
//
// A user can belong to multiple Guild records through
// GuildMembership.
//
// =============================================================

model Guild {
  id             String @id @default(cuid())
  discordGuildId String @unique
  name           String

  // -----------------------------------------------------------
  // Relations
  // -----------------------------------------------------------

  memberships GuildMembership[]

  members             GuildMember[]
  resources           Resource[]
  reservedAllocations ReservedAllocation[]
  rotationStates      RotationState[]
  allocationRuns      AllocationRun[]

  events Event[]

  preferredRosters PreferredRoster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================
// GUILD MEMBERSHIP
// =============================================================
//
// Connects a global User to a Guild.
//
// IMPORTANT:
// The role belongs here rather than on User because the same
// Discord user can have different roles in different guilds.
//
// Example:
//
// User X
//   Guild A -> LEADER
//   Guild B -> MEMBER
//   Guild C -> OFFICER
//
// =============================================================

model GuildMembership {
  id String @id @default(cuid())

  userId  String
  guildId String

  role UserRole @default(MEMBER)

  // -----------------------------------------------------------
  // Relations
  // -----------------------------------------------------------

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user can only have one membership in a particular guild.
  @@unique([userId, guildId])

  @@index([userId])
  @@index([guildId])
  @@index([guildId, role])
}

// =============================================================
// GUILD MEMBER
// =============================================================
//
// Represents the player's guild/character record.
//
// This remains separate from User.
//
// A User is the SaaS/Discord identity.
// A GuildMember is the in-game member record.
//
// discordUserId / discordUsername are imported Discord identity
// values. They let a guild leader link an existing member before
// that Discord account has ever signed into the application.
//
// userId is the internal User relation and is populated when the
// Discord account is known to the application or when the user
// signs in for the first time.
//
// =============================================================

model GuildMember {
  id String @id @default(cuid())

  guildId String
  userId  String?

  // -----------------------------------------------------------
  // Discord Identity
  // -----------------------------------------------------------

  discordUserId  String?
  discordUsername String?

  // -----------------------------------------------------------
  // Identity
  // -----------------------------------------------------------

  displayName   String
  characterName String?
  job           String?

  // -----------------------------------------------------------
  // Guild
  // -----------------------------------------------------------

  active   Boolean        @default(true)
  eligible Boolean        @default(true)
  priority MemberPriority @default(MEMBER)
  remarks  String?

  // -----------------------------------------------------------
  // Combat / Character Stats
  // -----------------------------------------------------------

  pdef Float?
  mdef Float?

  pvpDamageBonus     Float?
  pvpDamageReduction Float?

  pdmgPercent          Float?
  mdmgPercent          Float?
  pdmgReductionPercent Float?
  mdmgReductionPercent Float?

  critRes    Float?
  ignorePdef Float?
  ignoreMdef Float?

  damageVsMedium          Float?
  damageReductionVsMedium Float?

  damageVsSmall          Float?
  damageReductionVsSmall Float?

  damageVsDemiHuman          Float?
  damageReductionVsDemiHuman Float?

  damageVsBrute          Float?
  damageReductionVsBrute Float?

  equipmentPdefPercent Float?
  equipmentMdefPercent Float?

  patk Float?
  matk Float?
  hp   Float?

  // -----------------------------------------------------------
  // Relations
  // -----------------------------------------------------------

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Optional link between the in-game member and the global
  // SaaS/Discord user account.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([userId])
  @@index([discordUserId])
  @@index([discordUsername])
  @@unique([guildId, discordUserId])
}

// =============================================================
// RESOURCE
// =============================================================

model Resource {
  id String @id @default(cuid())

  guildId String
  name    String
  type    ResourceType
  quantity Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  reservedAllocations ReservedAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
}

// =============================================================
// RESERVED ALLOCATION
// =============================================================

model ReservedAllocation {
  id String @id @default(cuid())

  guildId    String
  memberId   String
  resourceId String
  quantity   Int @default(1)

  guild    Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member   GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([memberId])
  @@index([resourceId])
}

// =============================================================
// ROTATION STATE
// =============================================================

model RotationState {
  id String @id @default(cuid())

  guildId  String
  category String
  nextIndex Int @default(0)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([guildId, category])
  @@index([guildId])
}

// =============================================================
// EVENT
// =============================================================

model Event {
  id String @id @default(cuid())

  guildId String

  name String
  type EventType
  date DateTime

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  preferredRosters PreferredRoster[]
  rosters          EventRoster[]
  allocations      AllocationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([guildId, date])
}

// =============================================================
// PREFERRED ROSTER
// =============================================================

model PreferredRoster {
  id String @id @default(cuid())

  guildId String
  eventId String
  name    String

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  members PreferredRosterMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([eventId])
}

model PreferredRosterMember {
  id String @id @default(cuid())

  rosterId String
  memberId String

  roster PreferredRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  member GuildMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([rosterId, memberId])
  @@index([memberId])
}

// =============================================================
// EVENT ROSTER
// =============================================================

model EventRoster {
  id String @id @default(cuid())

  eventId String
  name    String

  mode RosterGenerationMode @default(MANUAL)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  members EventRosterMember[]
  parties EventRosterParty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model EventRosterMember {
  id String @id @default(cuid())

  rosterId String
  memberId String

  roster EventRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([rosterId, memberId])
  @@index([memberId])
}

model EventRosterParty {
  id String @id @default(cuid())

  rosterId String
  name     String

  roster EventRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  members EventRosterPartyMember[]

  @@index([rosterId])
}

model EventRosterPartyMember {
  id String @id @default(cuid())

  partyId  String
  memberId String

  party  EventRosterParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  member GuildMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([partyId, memberId])
  @@index([memberId])
}

// =============================================================
// ALLOCATION RUN
// =============================================================

model AllocationRun {
  id String @id @default(cuid())

  guildId String
  eventId String

  status AllocationRunStatus @default(RUNNING)

  eventDate DateTime

  nonReservedMemberCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  bids Bid[]

  @@index([guildId])
  @@index([eventId])
  @@index([guildId, eventId])
}

// =============================================================
// BID
// =============================================================

model Bid {
  id String @id @default(cuid())

  allocationRunId String
  memberId        String
  resourceId      String

  amount Int @default(0)

  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  member        GuildMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource      Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([allocationRunId])
  @@index([memberId])
  @@index([resourceId])
}
