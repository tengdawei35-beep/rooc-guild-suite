generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameType {
  ROOC
  RO3
}

enum MemberPriority {
  LEADER
  OFFICER
  COUNCIL
  MEMBER
}

enum UserRole {
  ADMIN
  MANAGER
  OFFICER
  MEMBER
}

enum ResourceType {
  FEATHER
  CARD
}

enum AllocationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BidPageType {
  FEATHER
  CARD
}

enum EventType {
  GUILD_LEAGUE
  EMPERIUM_OVERRUN
  RO3_CUSTOM
}

enum Ro3ResourceCategory {
  CARD
  EQUIPMENT
  ECHO
}

enum Ro3SeasonStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Ro3OptInCapMode {
  TOTAL
  PER_CATEGORY
  COMBINED
}

enum Ro3QueueEntryStatus {
  ACTIVE
  INACTIVE
}

enum Ro3AllocationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum Battlefield {
  BATTLEFIELD_1
  BATTLEFIELD_2
  BATTLEFIELD_3
  BATTLEFIELD_4
  BATTLEFIELD_5
  BATTLEFIELD_6
  BATTLEFIELD_7
  BATTLEFIELD_8
  BATTLEFIELD_9
  BATTLEFIELD_10
  BATTLEFIELD_11
  BATTLEFIELD_12
  BATTLEFIELD_13
  BATTLEFIELD_14
  BATTLEFIELD_15
  BATTLEFIELD_16
  BATTLEFIELD_17
  BATTLEFIELD_18
  BATTLEFIELD_19
  BATTLEFIELD_20
}

enum RosterGenerationMode {
  MANUAL
  AUTOMATIC
  PREFERRED
}

enum SaaSModule {
  CORE
  RESOURCE_SUITE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingInterval {
  MONTH
  YEAR
}

enum ApplicantStatus {
  PENDING
  ACCEPTED
  DENIED
}

model User {
  id String @id @default(cuid())
  discordId String @unique
  username String
  avatarUrl String?
  guildMemberships GuildMembership[]
  guildMembers GuildMember[]
  onboardingJourneys GuildRoleOnboardingProgress[]
  ownedGuilds Guild[] @relation("GuildOwner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guild {
  id String @id @default(cuid())
  discordGuildId String @unique
  name String
  gameType GameType @default(ROOC)
  timeZone String?
  ownerUserId String?
  memberships GuildMembership[]
  members GuildMember[]
  resources Resource[]
  reservedAllocations ReservedAllocation[]
  rotationStates RotationState[]
  allocationRuns AllocationRun[]
  events Event[]
  preferredRosters PreferredRoster[]
  owner User? @relation("GuildOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  onboardingProgress GuildOnboardingProgress?
  onboardingJourneys GuildRoleOnboardingProgress[]
  subscriptions GuildSubscription[]
  moduleEntitlements GuildModuleEntitlement[]
  ro3Seasons Ro3Season[]
  ro3EventTypes Ro3EventType[]
  customEventTypes GuildEventType[]
  eventResultImages EventResultImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerUserId])
}

model GuildMembership {
  id String @id @default(cuid())
  userId String
  guildId String
  role UserRole @default(MEMBER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
  @@index([guildId, role])
}

model GuildMember {
  id String @id @default(cuid())
  guildId String
  userId String?
  discordUserId String?
  discordUsername String?
  characterName String?
  job String?
  active Boolean @default(true)
  eligible Boolean @default(true)
  priority MemberPriority @default(MEMBER)
  remarks String?
  ro3Stats Json?
  pdef Float?
  mdef Float?
  pvpDamageBonus Float?
  pvpDamageReduction Float?
  pdmgPercent Float?
  mdmgPercent Float?
  pdmgReductionPercent Float?
  mdmgReductionPercent Float?
  critRes Float?
  ignorePdef Float?
  ignoreMdef Float?
  damageVsMedium Float?
  damageReductionVsMedium Float?
  damageVsSmall Float?
  damageReductionVsSmall Float?
  damageVsDemiHuman Float?
  damageReductionVsDemiHuman Float?
  damageVsBrute Float?
  damageReductionVsBrute Float?
  equipmentPdefPercent Float?
  equipmentMdefPercent Float?
  patk Float?
  matk Float?
  hp Float?
  guildPercentile Float?
  tankScore Float?
  tankPercentile Float?
  dpsScore Float?
  dpsPercentile Float?
  pvpScore Float?
  pvpPercentile Float?
  guildRank Int?
  tankRank Int?
  dpsRank Int?
  pvpRank Int?
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  reservations ReservedAllocation[]
  allocationResults AllocationResult[]
  bidSlots BidSlot[]
  leaveDates MemberLeave[]
  participations EventParticipation[]
  eventAttendance EventAttendance[]
  rosterAssignments RosterMember[]
  preferredRosterAssignments PreferredRosterMember[]
  ro3PersistentInterests Ro3PersistentInterest[]
  ro3EventOptIns Ro3EventOptIn[]
  ro3QueueEntries Ro3ResourceQueueEntry[]
  ro3AllocationResults Ro3AllocationResult[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, discordUserId])
  @@index([guildId])
  @@index([userId])
  @@index([discordUserId])
  @@index([discordUsername])
  @@index([job])
  @@index([active])
  @@index([eligible])
}

model MemberLeave {
  id String @id @default(cuid())
  memberId String
  date DateTime
  reason String?
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([memberId, date])
  @@index([memberId])
  @@index([date])
}

model Resource {
  id String @id @default(cuid())
  guildId String
  name String
  type ResourceType
  total Int
  perPlayerLimit Int
  hardCap Int
  active Boolean @default(true)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  reservations ReservedAllocation[]
  allocationResults AllocationResult[]
  resourceResults ResourceResult[]
  rotationStates RotationState[]
  bidSlots BidSlot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, name])
  @@index([guildId])
}

model ReservedAllocation {
  id String @id @default(cuid())
  guildId String
  memberId String
  resourceId String
  quantity Int
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, memberId, resourceId])
  @@index([guildId])
  @@index([memberId])
  @@index([resourceId])
}

model RotationState {
  id String @id @default(cuid())
  guildId String
  resourceId String
  rotationIndex Int @default(0)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, resourceId])
  @@index([guildId])
}

model AllocationRun {
  id String @id @default(cuid())
  guildId String
  eventId String?
  status AllocationRunStatus @default(RUNNING)
  rotationIndexBefore Json?
  rotationIndexAfter Json?
  errorMessage String?
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  allocationResults AllocationResult[]
  resourceResults ResourceResult[]
  bidPages BidPage[]
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([guildId])
  @@index([guildId, createdAt])
  @@index([eventId])
}

model AllocationResult {
  id String @id @default(cuid())
  allocationRunId String
  memberId String
  resourceId String
  reservedQuantity Int @default(0)
  assignedQuantity Int @default(0)
  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([allocationRunId, memberId, resourceId])
  @@index([allocationRunId])
  @@index([memberId])
  @@index([resourceId])
}

model ResourceResult {
  id String @id @default(cuid())
  allocationRunId String
  resourceId String
  total Int
  reserved Int
  allocated Int
  overflow Int
  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@unique([allocationRunId, resourceId])
  @@index([allocationRunId])
}

model BidPage {
  id String @id @default(cuid())
  allocationRunId String
  type BidPageType
  pageNumber Int
  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  slots BidSlot[]
  createdAt DateTime @default(now())
  @@unique([allocationRunId, type, pageNumber])
  @@index([allocationRunId])
}

model BidSlot {
  id String @id @default(cuid())
  bidPageId String
  slotNumber Int
  resourceId String
  memberId String
  bidPage BidPage @relation(fields: [bidPageId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([bidPageId, slotNumber])
  @@index([bidPageId])
}

model Event {
  id String @id @default(cuid())
  guildId String
  type EventType
  date DateTime
  finalRosterId String?
  ro3EventTypeId String?
  guildEventTypeId String?
  eventTypeName String?
  battlefieldCount Int?
  partiesPerBattlefield Int?
  scheduleTimeZone String?
  attendanceChannelId String?
  attendanceMessageId String?
  reminderMessageId String?
  ro3OptInsLockedAt DateTime?
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ro3EventType Ro3EventType? @relation(fields: [ro3EventTypeId], references: [id], onDelete: SetNull)
  guildEventType GuildEventType? @relation(fields: [guildEventTypeId], references: [id], onDelete: SetNull)
  attendance EventAttendance[]
  resultImages EventResultImage[]
  ro3Rewards Ro3EventReward[]
  ro3EventOptIns Ro3EventOptIn[]
  ro3AllocationRun Ro3AllocationRun?
  participations EventParticipation[]
  rosters Roster[]
  finalRoster Roster? @relation("EventFinalRoster", fields: [finalRosterId], references: [id], onDelete: SetNull)
  allocationRuns AllocationRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([guildId])
  @@index([date])
  @@index([ro3EventTypeId])
  @@index([guildEventTypeId])
  @@unique([guildId, type, date, ro3EventTypeId])
  @@unique([finalRosterId])
  @@index([finalRosterId])
}

model EventParticipation {
  id String @id @default(cuid())
  eventId String
  memberId String
  available Boolean @default(true)
  remarks String?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model Roster {
  id String @id @default(cuid())
  eventId String
  name String
  generationMode RosterGenerationMode
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  finalForEvent Event? @relation("EventFinalRoster")
  parties RosterParty[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventId])
}

model RosterParty {
  id String @id @default(cuid())
  rosterId String
  partyNumber Int
  battlefield Battlefield
  roster Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  members RosterMember[]
  raids RaidParty[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([rosterId, battlefield, partyNumber])
  @@index([rosterId])
}

model RosterMember {
  id String @id @default(cuid())
  partyId String
  memberId String
  slotNumber Int
  guildPercentile Float
  tankScore Float
  tankPercentile Float
  dpsScore Float
  dpsPercentile Float
  pvpScore Float
  pvpPercentile Float
  party RosterParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([partyId, slotNumber])
  @@index([partyId])
  @@index([memberId])
}

model Raid {
  id String @id @default(cuid())
  name String
  parties RaidParty[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RaidParty {
  id String @id @default(cuid())
  raidId String
  partyId String
  raid Raid @relation(fields: [raidId], references: [id], onDelete: Cascade)
  party RosterParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([raidId, partyId])
  @@index([raidId])
  @@index([partyId])
}

model PreferredRoster {
  id String @id @default(cuid())
  guildId String
  type EventType
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  parties PreferredRosterParty[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, type])
  @@index([guildId])
  @@index([type])
}

model PreferredRosterParty {
  id String @id @default(cuid())
  preferredRosterId String
  battlefield Battlefield
  partyNumber Int
  preferredRoster PreferredRoster @relation(fields: [preferredRosterId], references: [id], onDelete: Cascade)
  members PreferredRosterMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([preferredRosterId, battlefield, partyNumber])
  @@index([preferredRosterId])
}

model PreferredRosterMember {
  id String @id @default(cuid())
  preferredRosterPartyId String
  memberId String
  slotNumber Int
  preferredRosterParty PreferredRosterParty @relation(fields: [preferredRosterPartyId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([preferredRosterPartyId, slotNumber])
  @@unique([preferredRosterPartyId, memberId])
  @@index([preferredRosterPartyId])
  @@index([memberId])
}

model PlatformGuildCreator {
  id String @id @default(cuid())
  discordUserId String @unique
  discordUsername String
  maxGuilds Int @default(1)
  freeMonths Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}

model Plan {
  id String @id @default(cuid())
  name String @unique
  description String?
  priceCents Int
  currency String @default("usd")
  billingInterval BillingInterval @default(MONTH)
  active Boolean @default(true)
  modules PlanModule[]
  subscriptions GuildSubscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanModule {
  id String @id @default(cuid())
  planId String
  module SaaSModule
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([planId, module])
  @@index([module])
}

model GuildSubscription {
  id String @id @default(cuid())
  guildId String
  planId String
  status SubscriptionStatus @default(INCOMPLETE)
  provider String?
  providerCustomerId String?
  providerSubscriptionId String? @unique
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([guildId, status])
  @@index([planId])
  @@index([providerCustomerId])
}

model GuildModuleEntitlement {
  id String @id @default(cuid())
  guildId String
  module SaaSModule
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@unique([guildId, module])
  @@index([module])
}

model ApplicantInvite {
  id String @id @default(cuid())
  guildId String
  token String @unique
  active Boolean @default(true)
  createdByUserId String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([guildId, active])
  @@index([createdByUserId])
}

model GuildApplicant {
  id String @id @default(cuid())
  guildId String
  inviteId String
  discordUserId String
  discordUsername String
  userId String?
  characterName String
  job String?
  status ApplicantStatus @default(PENDING)
  remarks String?
  ro3Stats Json?
  pdef Float?
  mdef Float?
  pvpDamageBonus Float?
  pvpDamageReduction Float?
  pdmgPercent Float?
  mdmgPercent Float?
  pdmgReductionPercent Float?
  mdmgReductionPercent Float?
  critRes Float?
  ignorePdef Float?
  ignoreMdef Float?
  damageVsMedium Float?
  damageReductionVsMedium Float?
  damageVsSmall Float?
  damageReductionVsSmall Float?
  damageVsDemiHuman Float?
  damageReductionVsDemiHuman Float?
  damageVsBrute Float?
  damageReductionVsBrute Float?
  equipmentPdefPercent Float?
  equipmentMdefPercent Float?
  patk Float?
  matk Float?
  hp Float?
  dpsScore Float?
  tankScore Float?
  pvpScore Float?
  dpsPercentile Float?
  tankPercentile Float?
  pvpPercentile Float?
  reviewedAt DateTime?
  reviewedByUserId String?
  decidedAt DateTime?
  decidedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, discordUserId])
  @@index([guildId, status])
  @@index([guildId, discordUserId])
  @@index([inviteId])
}


//
// RO3 RESOURCE BIDDING FOUNDATION
// These models are intentionally separate from the legacy ROOC allocation
// models so that the two game modules can evolve independently.
//

model Ro3Season {
  id String @id @default(cuid())
  guildId String
  name String
  status Ro3SeasonStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  capMode Ro3OptInCapMode @default(TOTAL)
  totalOptInCap Int?
  cardOptInCap Int?
  equipmentOptInCap Int?
  echoOptInCap Int?
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  resources Ro3SeasonResource[]
  eventTypes Ro3EventType[]
  allocationRuns Ro3AllocationRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, name])
  @@index([guildId, status])
}

model Ro3SeasonResource {
  id String @id @default(cuid())
  seasonId String
  name String
  category Ro3ResourceCategory
  active Boolean @default(true)
  season Ro3Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  persistentInterests Ro3PersistentInterest[]
  rewardPoolEntries Ro3EventRewardPool[]
  eventOptIns Ro3EventOptIn[]
  eventRewards Ro3EventReward[]
  rotation Ro3ResourceRotation?
  allocationResults Ro3AllocationResult[]
  allocationResourceResults Ro3AllocationResourceResult[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([seasonId, name])
  @@index([seasonId, category])
  @@index([seasonId, active])
}

model Ro3EventType {
  id String @id @default(cuid())
  guildId String
  seasonId String
  name String
  active Boolean @default(true)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  season Ro3Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  events Event[]
  guildEventTypeId String?
  guildEventType GuildEventType? @relation(fields: [guildEventTypeId], references: [id], onDelete: SetNull)
  rewardPool Ro3EventRewardPool[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([seasonId, name])
  @@index([guildId])
  @@index([seasonId, active])
}

model Ro3EventRewardPool {
  id String @id @default(cuid())
  eventTypeId String
  resourceId String
  quantity Int
  eventType Ro3EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventTypeId, resourceId])
  @@index([resourceId])
}

model Ro3EventReward {
  id String @id @default(cuid())
  eventId String
  resourceId String
  quantity Int
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, resourceId])
  @@index([resourceId])
}

model Ro3PersistentInterest {
  id String @id @default(cuid())
  memberId String
  resourceId String
  quantity Int
  active Boolean @default(true)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([memberId, resourceId])
  @@index([resourceId, active])
}

model Ro3EventOptIn {
  id String @id @default(cuid())
  eventId String
  memberId String
  resourceId String
  quantity Int
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, memberId, resourceId])
  @@index([eventId, resourceId])
  @@index([memberId])
}

model Ro3ResourceRotation {
  id String @id @default(cuid())
  resourceId String @unique
  initializedAt DateTime?
  initializedByUserId String?
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  entries Ro3ResourceQueueEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ro3ResourceQueueEntry {
  id String @id @default(cuid())
  rotationId String
  memberId String
  position Int
  status Ro3QueueEntryStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  removedAt DateTime?
  rotation Ro3ResourceRotation @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([rotationId, memberId])
  @@index([rotationId, status, position])
  @@index([memberId])
}

model Ro3AllocationRun {
  id String @id @default(cuid())
  seasonId String
  eventId String @unique
  status Ro3AllocationStatus @default(RUNNING)
  errorMessage String?
  rotationSnapshotBefore Json?
  rotationSnapshotAfter Json?
  season Ro3Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  results Ro3AllocationResult[]
  resourceResults Ro3AllocationResourceResult[]
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([seasonId, createdAt])
}

model Ro3AllocationResult {
  id String @id @default(cuid())
  allocationRunId String
  memberId String
  resourceId String
  quantity Int
  allocationRun Ro3AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([allocationRunId, memberId, resourceId])
  @@index([memberId])
  @@index([resourceId])
}

model Ro3AllocationResourceResult {
  id String @id @default(cuid())
  allocationRunId String
  resourceId String
  totalQuantity Int
  allocatedQuantity Int
  unallocatedQuantity Int
  allocationRun Ro3AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  resource Ro3SeasonResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  @@unique([allocationRunId, resourceId])
  @@index([resourceId])
}

enum EventAttendanceStatus {
  AVAILABLE
  UNAVAILABLE
  AFK_BUSY
}

model GuildEventType {
  id String @id @default(cuid())
  guildId String
  name String
  active Boolean @default(true)
  battlefieldCount Int @default(2)
  partiesPerBattlefield Int @default(4)
  weekdays Int[]
  startTime String @default("20:00")
  timeZone String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  events Event[]
  resourceEventTypes Ro3EventType[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, name])
  @@index([guildId, active])
}

model EventAttendance {
  id String @id @default(cuid())
  eventId String
  memberId String
  status EventAttendanceStatus
  respondedAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([eventId, memberId])
  @@index([eventId, status])
  @@index([memberId])
}

model EventResultImage {
  id String @id @default(cuid())
  eventId String
  guildId String
  storagePath String @unique
  url String
  fileName String
  contentType String
  size Int
  uploadedByUserId String
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  @@index([guildId, createdAt])
  @@index([eventId])
}


model GuildOnboardingProgress {
  id String @id @default(cuid())
  guildId String @unique
  dismissedAt DateTime?
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model GuildRoleOnboardingProgress {
  id String @id @default(cuid())
  userId String
  guildId String
  completedStepIds String[] @default([])
  dismissedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, guildId])
  @@index([guildId])
}
