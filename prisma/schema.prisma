generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberPriority {
  LEADER
  OFFICER
  COUNCIL
  MEMBER
}

enum ResourceType {
  FEATHER
  CARD
}

enum AllocationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BidPageType {
  FEATHER
  CARD
}

model User {
  id        String  @id @default(cuid())
  discordId String  @unique
  username  String
  avatarUrl String?

  guildMemberships GuildMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guild {
  id             String @id @default(cuid())
  discordGuildId String @unique
  name           String

  members             GuildMember[]
  resources           Resource[]
  reservedAllocations ReservedAllocation[]
  rotationStates      RotationState[]
  allocationRuns      AllocationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuildMember {
  id String @id @default(cuid())

  guildId String
  userId  String?

  displayName String

  active   Boolean        @default(true)
  eligible Boolean        @default(true)
  priority MemberPriority @default(MEMBER)
  remarks  String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  reservations      ReservedAllocation[]
  allocationResults AllocationResult[]
  bidSlots          BidSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, displayName])
  @@index([guildId])
  @@index([userId])
}

model Resource {
  id String @id @default(cuid())

  guildId String

  name           String
  type           ResourceType
  total          Int
  perPlayerLimit Int
  active         Boolean      @default(true)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  reservations      ReservedAllocation[]
  allocationResults AllocationResult[]
  resourceResults   ResourceResult[]
  rotationStates    RotationState[]
  bidSlots          BidSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId])
}

model ReservedAllocation {
  id String @id @default(cuid())

  guildId    String
  memberId   String
  resourceId String

  quantity Int

  guild    Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member   GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, memberId, resourceId])
  @@index([guildId])
  @@index([memberId])
  @@index([resourceId])
}

model RotationState {
  id String @id @default(cuid())

  guildId    String
  resourceId String

  rotationIndex Int @default(0)

  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, resourceId])
  @@index([guildId])
}

model AllocationRun {
  id String @id @default(cuid())

  guildId String

  status AllocationRunStatus @default(RUNNING)

  rotationIndexBefore Json?
  rotationIndexAfter  Json?

  errorMessage String?

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  allocationResults AllocationResult[]
  resourceResults   ResourceResult[]
  bidPages          BidPage[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([guildId])
  @@index([guildId, createdAt])
}

model AllocationResult {
  id String @id @default(cuid())

  allocationRunId String
  memberId        String
  resourceId      String

  reservedQuantity Int @default(0)
  assignedQuantity Int @default(0)

  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  member        GuildMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  resource      Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([allocationRunId, memberId, resourceId])
  @@index([allocationRunId])
  @@index([memberId])
  @@index([resourceId])
}

model ResourceResult {
  id String @id @default(cuid())

  allocationRunId String
  resourceId      String

  total     Int
  reserved  Int
  allocated Int
  overflow  Int

  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  resource      Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([allocationRunId, resourceId])
  @@index([allocationRunId])
}

model BidPage {
  id String @id @default(cuid())

  allocationRunId String

  type       BidPageType
  pageNumber Int

  allocationRun AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)

  slots BidSlot[]

  createdAt DateTime @default(now())

  @@unique([allocationRunId, type, pageNumber])
  @@index([allocationRunId])
}

model BidSlot {
  id String @id @default(cuid())

  bidPageId String

  slotNumber Int

  resourceId String
  memberId   String

  bidPage  BidPage     @relation(fields: [bidPageId], references: [id], onDelete: Cascade)
  resource Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  member   GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([bidPageId, slotNumber])
  @@index([bidPageId])
}
